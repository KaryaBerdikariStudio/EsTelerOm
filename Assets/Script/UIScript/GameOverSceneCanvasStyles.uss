/* Main container */
.gameOverContainer {
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 20px;
    background-color: rgba(0, 0, 0, 0.8);
}

/* Title */
.gameOverTitle {
    font-size: 48px;
    color: #ff0000;
    -unity-text-align: middle-center;
    margin-bottom: 30px;
}

/* Scores container */
.scoresContainer {
    flex-grow: 1;
    width: 80%;
    margin: 0 auto;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 15px;
}

.scoresHeader {
    flex-direction: row;
    justify-content: space-between;
    padding: 10px 20px;
    border-bottom: 2px solid #ffffff;
    margin-bottom: 10px;
}

.scoreHeaderLabel {
    font-size: 24px;
    color: #ffffff;
    width: 45%;
}

/* Score entries */
.scoreEntries {
    flex-direction: column;
    gap: 8px;
}

.scoreEntry {
    flex-direction: row;
    justify-content: space-between;
    padding: 8px 20px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
}

.playerName {
    font-size: 18px;
    color: #ffffff;
    width: 45%;
}

.playerScore {
    font-size: 18px;
    color: #ffd700;
    width: 45%;
    -unity-text-align: right;
}

/* Action buttons */
.buttonGroup {
    flex-direction: row;
    justify-content: center;
    gap: 20px;
    margin-top: 30px;
    padding: 20px;
}

.actionButton {
    min-width: 160px;
    height: 50px;
    border-radius: 8px;
    font-size: 18px;
    -unity-text-align: middle-center;
    transition: all 0.3s ease;
}

.actionButton:hover {
    opacity: 0.9;
    transform: scale(1.05);
}

.retryButton { background-color: #4CAF50; color: white; }
.continueButton { background-color: #2196F3; color: white; }
.submitButton { background-color: #FFC107; color: black; }
.menuButton { background-color: #9E9E9E; color: white; }