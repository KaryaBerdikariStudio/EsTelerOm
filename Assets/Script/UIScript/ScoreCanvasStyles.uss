.ScoreCanvas {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    color: white;
    width: 40%;
    font-size: 100%;
    white-space: normal;
}

/* Player name takes up twice as much as the numeric region */
.nama {
    /* grow 2, shrink 1, basis 0 */
    flex-grow: 2;
    flex-shrink: 1;
    flex-basis: 0%;
    -unity-text-align: middle-left;
}

/* Wrap the “:”, score and combo together */
.labelSkorContainer {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;

    /* grow 3, shrink 1, basis 0 */
    flex-grow: 3;
    flex-shrink: 1;
    flex-basis: 0%;
}

/* The colon is fixed size (no grow) */
.labelSkor {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto; /* or whatever min size you need */
    -unity-text-align: middle-center;
}

/* Score value: grow 1 */
.skor {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    -unity-text-align: middle-right;
}

/* Combo value: grow 2 */
.kombo {
    flex-grow: 2;
    flex-shrink: 1;
    flex-basis: 0%;
    -unity-text-align: middle-center;
}
