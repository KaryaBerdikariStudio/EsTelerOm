<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Script/UIScript/ScoreCanvasStyles.uss" />
    
    <engine:VisualElement name="ScoreCanvas" class="ScoreCanvas">
  <engine:Label
    name="labelNama"
    text="Nama"
    class="nama" />

  <!-- NEW: wrap the numeric bits in a flex‐row container -->
  <engine:VisualElement class="labelSkorContainer">
    <engine:Label
      name="labelSkor"
      text=":"
      class="labelSkor" />
    <engine:Label
      name="labelSkorValue"
      text="0"
      class="labelSkorValue skor" />
    <engine:Label
      name="labelKomboValue"
      text="(0)"
      class="labelKomboValue kombo" />
  </engine:VisualElement>
</engine:VisualElement>

</engine:UXML>
